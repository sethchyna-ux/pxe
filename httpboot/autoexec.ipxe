#!ipxe
echo PXE-RS Stage 2 Bootloader [Client: ${ip} -> Server: ${server_ip}:${http_port}]
isset ${ip} || set net0/ip 10.77.0.2
isset ${netmask} || set net0/netmask 255.255.0.0
isset ${gateway} || set net0/gateway ${server_ip}
ifopen net0 ||
set dns ${server_ip}
echo Chainloading PXE Netboot Menu...
chain --autofree http://${server_ip}:${http_port}/boot.ipxe || chain --autofree tftp://${server_ip}/boot.ipxe || dhcp && chain --autofree http://${server_ip}:${http_port}/boot.ipxe || shell
